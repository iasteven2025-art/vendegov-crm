rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == "steven.passos@computeck.com.br";
    }

    function tenantPath(tenantId) {
      return /databases/(default)/documents/tenants/$(tenantId);
    }

    function emailAllowed(tenantId) {
      return signedIn() &&
        firestore.exists(tenantPath(tenantId)) &&
        firestore.get(tenantPath(tenantId)).data.get("allowedEmails", []).hasAny([request.auth.token.email]);
    }

    function isMember(tenantId) {
      return signedIn() && (
        isSuperAdmin() ||
        firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
        emailAllowed(tenantId)
      );
    }

    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if isMember(tenantId);
      allow write: if isMember(tenantId) &&
        (request.resource == null || request.resource.size < 20 * 1024 * 1024);
    }
  }
}
