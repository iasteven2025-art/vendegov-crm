rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == "steven.passos@computeck.com.br";
    }

    function memberPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function tenantPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId);
    }

    function tenantExists(tenantId) {
      return exists(tenantPath(tenantId));
    }

    function emailAllowed(tenantId) {
      return signedIn() &&
        tenantExists(tenantId) &&
        get(tenantPath(tenantId)).data.get("allowedEmails", []).hasAny([request.auth.token.email]);
    }

    function emailAdmin(tenantId) {
      return signedIn() &&
        tenantExists(tenantId) &&
        get(tenantPath(tenantId)).data.get("adminEmails", []).hasAny([request.auth.token.email]);
    }

    function isMember(tenantId) {
      return signedIn() && (isSuperAdmin() || exists(memberPath(tenantId)) || emailAllowed(tenantId));
    }

    function isAdmin(tenantId) {
      return signedIn() && (
        isSuperAdmin() ||
        (exists(memberPath(tenantId)) && get(memberPath(tenantId)).data.role == "admin") ||
        emailAdmin(tenantId)
      );
    }

    function tenantCollectionProtected(collectionId) {
      return collectionId in ["members", "public", "snapshots", "outbox"];
    }

    function sharedTenantCollection(collectionId) {
      return collectionId in ["empresas", "regioes"];
    }

    function tenantUsesCollections(tenantId) {
      return tenantExists(tenantId) &&
        get(tenantPath(tenantId)).data.get("dataMode", "") == "collections";
    }

    function resourceBelongsToTenant(tenantId) {
      return !("tenantId" in request.resource.data) || request.resource.data.tenantId == tenantId;
    }

    function recordMatchesUser(data) {
      return signedIn() && (
        data.get("consultantEmail", "") == request.auth.token.email ||
        data.get("consultor_responsavel", "") == request.auth.token.email ||
        data.get("ownerEmail", "") == request.auth.token.email ||
        data.get("responsibleEmail", "") == request.auth.token.email ||
        data.get("userEmail", "") == request.auth.token.email ||
        data.get("email", "") == request.auth.token.email ||
        data.get("createdByUid", "") == request.auth.uid
      );
    }

    function canReadTenantRecord(tenantId, collectionId) {
      return isAdmin(tenantId) ||
        sharedTenantCollection(collectionId) ||
        recordMatchesUser(resource.data);
    }

    function canWriteTenantRecord(tenantId, collectionId) {
      return isAdmin(tenantId) ||
        (
          isMember(tenantId) &&
          !sharedTenantCollection(collectionId) &&
          resourceBelongsToTenant(tenantId) &&
          recordMatchesUser(request.resource.data)
        );
    }

    match /platform/{document=**} {
      allow read, write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow read: if isMember(tenantId);
      allow create: if isSuperAdmin() &&
        !tenantExists(tenantId) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.adminEmails.hasAny([request.auth.token.email]);
      allow update: if isAdmin(tenantId);
      allow delete: if false;

      match /members/{userId} {
        allow read: if isMember(tenantId);
        allow create: if isSuperAdmin() || isAdmin(tenantId) || (
          signedIn() &&
          userId == request.auth.uid &&
          tenantExists(tenantId) &&
          get(tenantPath(tenantId)).data.createdByUid == request.auth.uid
        );
        allow update, delete: if isAdmin(tenantId);
      }

      match /public/{documentId} {
        allow read: if true;
        allow write: if isAdmin(tenantId);
      }

      match /snapshots/{snapshotId} {
        allow read, write: if isAdmin(tenantId) || (
          isMember(tenantId) &&
          !tenantUsesCollections(tenantId)
        );
      }

      match /outbox/{messageId} {
        allow read, write: if isMember(tenantId);
      }

      match /{collectionId}/{recordId} {
        allow read: if isMember(tenantId) &&
          !tenantCollectionProtected(collectionId) &&
          canReadTenantRecord(tenantId, collectionId);
        allow create: if isMember(tenantId) &&
          !tenantCollectionProtected(collectionId) &&
          canWriteTenantRecord(tenantId, collectionId);
        allow update: if isMember(tenantId) &&
          !tenantCollectionProtected(collectionId) &&
          canReadTenantRecord(tenantId, collectionId) &&
          canWriteTenantRecord(tenantId, collectionId);
        allow delete: if !tenantCollectionProtected(collectionId) && (
          isAdmin(tenantId) ||
          (
            isMember(tenantId) &&
            !sharedTenantCollection(collectionId) &&
            collectionId != "usuarios" &&
            canReadTenantRecord(tenantId, collectionId)
          )
        );
      }

      match /{collectionId}/{recordId}/{subCollectionId}/{subRecordId} {
        allow read: if isMember(tenantId) &&
          !tenantCollectionProtected(collectionId) &&
          canReadTenantRecord(tenantId, collectionId);
        allow create, update: if isMember(tenantId) &&
          !tenantCollectionProtected(collectionId) &&
          resourceBelongsToTenant(tenantId) &&
          canWriteTenantRecord(tenantId, collectionId);
        allow delete: if !tenantCollectionProtected(collectionId) && (
          isAdmin(tenantId) ||
          (
            isMember(tenantId) &&
            !sharedTenantCollection(collectionId) &&
            collectionId != "usuarios" &&
            canReadTenantRecord(tenantId, collectionId)
          )
        );
      }
    }
  }
}
